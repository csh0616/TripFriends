{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.production)",
      "Read(./apps/server/.env)",
      "Read(./apps/mobile/.env.local)",
      "Bash(*apps/server/.env)",
      "Bash(*apps/server/.env *)",
      "Bash(*apps/mobile/.env.local)",
      "Bash(*apps/mobile/.env.local *)",
      "Read(~/.config/tripfriends/server.env)",
      "Edit(~/.config/tripfriends/server.env)",
      "Bash(*.config/tripfriends/server.env)",
      "Bash(*.config/tripfriends/server.env *)"
    ]
  }
}
