AI_GATEWAY_API_KEY=
APP_ENV=development
# 추적(langsmith) 전송은 R1에서 강제로 끈다. 서버 시작 때 LANGSMITH_TRACING, LANGSMITH_TRACING_V2, LANGCHAIN_TRACING_V2를
# 모두 false로 덮어쓴다 (이 값을 true로 바꿔도 소용없음, TASK-003 §10-11 R13)
LANGSMITH_TRACING=false

# 실제 장소 데이터 (TASK-010). 값은 .env에만 넣고 여기에는 이름만 둔다
# 구글 장소 API 키 (영업시간·좌표)
GOOGLE_PLACES_API_KEY=
# Serper 검색 키 (영업시간 보조)
SERPER_API_KEY=
# 장소 공급자 (fake면 가짜 공급자, 키가 없어도 가짜)
PLACES_PROVIDER=
