AI_GATEWAY_API_KEY=
APP_ENV=development
# 추적(langsmith) 전송은 R1에서 강제로 끈다. 서버 시작 때 LANGSMITH_TRACING, LANGSMITH_TRACING_V2, LANGCHAIN_TRACING_V2를
# 모두 false로 덮어쓴다 (이 값을 true로 바꿔도 소용없음, TASK-003 §10-11 R13)
LANGSMITH_TRACING=false

# 실제 장소 데이터 (TASK-010). 값은 .env에만 넣고 여기에는 이름만 둔다
# 구글 장소 API 키 (영업시간·좌표)
GOOGLE_PLACES_API_KEY=
# Serper 검색 키 (영업시간 보조)
SERPER_API_KEY=
# 장소 공급자 (fake면 가짜 공급자, 키가 없어도 가짜)
PLACES_PROVIDER=

# 저장소·로그인 (TASK-012). 값은 .env에만 넣고 여기에는 이름만 둔다
# DB 연결 주소 (Supabase 프로젝트 → Connect → Postgres 연결 문자열, 비밀). 비어 있으면 서버는 메모리 저장소로 켜져 서버를 끄면 데이터가 사라진다.
# 서버 전용이라 앱에는 절대 두지 않는다. 로컬 점검은 supabase/README.md의 로컬 주소를 쓴다 (클라우드 프로젝트를 점검에 쓰지 않는다)
DATABASE_URL=
# Supabase 프로젝트 URL (공개 값). 서버가 `{SUPABASE_URL}/auth/v1/.well-known/jwks.json`에서 공개 키를 받아 로그인 토큰을 확인한다.
# 비어 있으면 인증이 필요한 모든 요청이 401 (닫힌 채로 실패). 로그인 토큰 비밀값(SUPABASE_JWT_SECRET)은 쓰지 않는다 (비대칭 키, ADR-016)
SUPABASE_URL=
# 테스트 전용 (서버는 읽지 않음): `uv run pytest -m db`가 붙는 **로컬** Postgres 주소. 로컬이 아니면 DB 테스트를 건너뛴다.
# 값은 `supabase start`가 알려 주는 DB URL. 결정권자의 클라우드 프로젝트 주소를 넣지 않는다
# TEST_DATABASE_URL=
