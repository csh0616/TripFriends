{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/screen-for.ts",
    "src/lib/planning-reducer.ts",
    "src/lib/distance-label.ts",
    "src/lib/format-stay.ts",
    "src/lib/today-hours-text.ts",
    "src/lib/project-route.ts",
    "src/lib/placeholder-for.ts",
    "src/lib/contrast.ts",
    "src/lib/fake-position.ts",
    "src/lib/demo-clock.ts",
    "src/lib/particle.ts",
    "src/lib/source-label.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 30000,
  "plugins": [
    "@stryker-mutator/jest-runner"
  ],
  "inPlace": true,
  "jest": {
    "config": {
      "preset": "jest-expo",
      "setupFiles": [
        "./jest.setup.ts"
      ],
      "testMatch": [
        "<rootDir>/__tests__/planning-lib.test.ts",
        "<rootDir>/__tests__/fake-position.test.ts",
        "<rootDir>/__tests__/delayed-position.test.ts",
        "<rootDir>/__tests__/trip-now.test.tsx",
        "<rootDir>/__tests__/trip-delay.test.tsx",
        "<rootDir>/__tests__/particle.test.ts",
        "<rootDir>/__tests__/task-009-select.test.tsx"
      ],
      "moduleNameMapper": {
        "\\.css$": "<rootDir>/jest/style-mock.js",
        "^@/assets/(.*)$": "<rootDir>/assets/$1",
        "^@/(.*)$": "<rootDir>/src/$1"
      },
      "setupFilesAfterEnv": [
        "./jest/stryker-fast-fail.ts"
      ]
    }
  },
  "tempDirName": ".stryker-tmp"
}
